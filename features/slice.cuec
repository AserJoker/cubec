comptime func slice(t:type):type {
    return struct {
        data:[*]t;
        start:u64;
        length:u64;
        func __get_index__(self:*__self__,idx:u64):&t {
            if(idx > length) {
                panic("out of range");
            }
            return self.data[idx];
        }
        func __set_index__(self:*__self__,idx:u64,value:t):__self__ {
            if(idx > length) {
                panic("out of range");
            }
            return self.data[idx] = value;
        }
        comptime func _get_field_type(name:str):type {
            if(name == "length") {
                return u64;
            }
            __compiler__error("no member %s in value",str);
        }
        func __get_field__(self: *__self__,comptime name:str): _get_field_type(name) {
            if(name == "length"){
                return self.length;
            }
        }
        func __length__(self:*__self__):u64{
            return self.length;
        }
    }
}
const arr = i32[_]{
    1,2,3,4
};
const s:slice(i32) = arr[1:2]; // [2,3]
s.length
s[0];// -> arr[1]