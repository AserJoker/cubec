extern func write(fd:i32, string:[*]u8, len:u64): i32;
comptime const stdout = 1;
comptime const stderr = 2;
comptime const stdin = 3;
func strlen(str: [*]u8): u64 {
    u64 len = 0;
    while (str[len] != '\0') {
        len++;
    }
    return len;
}
func println(str: [*]u8): void {
    _ = write(stdout, str, strlen(str));
}