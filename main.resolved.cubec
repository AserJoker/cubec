comptime func add(T: type, aa: i32): func(T, T) -> T {
    return func [T, aa](a: T, b: T): T {
        print("%v", aa);
        return a + b;
    };
}
func main(argc: i32, argv: [*]str): i32 {
    comptime const v = 123;
    const add_i32 = add(i32, v);
    const add_u32 = add(u32, v);
    print("%v", add_i32 == add_i32);
    return 0;
}
