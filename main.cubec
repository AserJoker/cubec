struct Test{
    id:i32;
    pub func create(id:i32):__self__ {
        let result = __self__{};
        result.id = id;
        return result;
    }
    pub template func add(a:auto,b:__typeof__(a)):__typeof__(a){
        return a+b;
    }
};
func init(id:i32):Test {
    const item =  .create(id);
    return item;
}
pub func main():void{
    comptime const item = init(123);
    __print__("%v",item);
}