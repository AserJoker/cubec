import { Buffer } from 'memory';
import { Error } from 'error';
import { read, open, close, FileMode } from 'posix';
struct Readable{
    read: func(self:Readable, len: uint64_t): Buffer|Error;
}
struct File {
    Readable;
    _fd:int32_t;
    func open(path: String,mode: FileMode) File|Error {
        let file = try new(File);
        file._fd = try open(path, mode);
        return file;
    }
    meta dispose(self:File): Error|void {
        try self.close();
    }
    func read(self:File,len:uint64_t){
        let buffer = try new(Buffer);
        try buffer.resize(len);
        _ = try read(self._fd, buffer);
        return buffer;
    }
    func close(self:File) {
        try close(self._fd);
    }
}

test "FileTest" {
    using file = try File.open("./1.txt", FileMode.O_RDONLY);
    using buf = try file.read(1024);
    assert buf.toString() == "hello world";
}