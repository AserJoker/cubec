import { default_heap_allocator } from 'memory';
import { Type } from 'compiler'
comptime func new(type:Type):type {
    const result = type(default_heap_allocator.calloc(sizeof(type)));
    if(type.isStruct()) {
        const stru = Struct(type);
        foreach(const extend : stru.extends) {
            foreach(const method:extend.methods) {
                if(!method.name){
                    continue;
                }
                const func = Type.findFunction(method.name,type,...arraymethod.args) ??
                             Type.findFunction(method.name,type.ref(),...method.args);
                if(func&&func.type == method.type){
                    result[method.name] = func;
                }
            }
        }
    }
    return result;
}
template delete(value:anytype) {
    type t = typeof(value);
    if(!t.isStruct()&&!t.isArray()){
        CompileError("cannot delete '{}'", t.name);
    }
    default_heap_allocator.free(pointer(t));
}