enum Type{
    A,B,C
}

enum Type2:str{
    A("A"),
    B("B"),
    C("C),
}

comptime func getItemName(item:Enum):str {
    return type(item).name();
}

enum Type3:getItemName {
    A,B,C
}

testsuit "EnumTest" {
    test "basic" {
        assert Type.A == 0;
        assert Type.B == 1;
        assert Type.C == 2;
    }
    test "custom type" {
        asset Type2.A == string("a");
        asset Type2.B == string("b");
        asset Type2.C == string("c");
    }
    test "getter type" {
        asset Type3.A == string("A");
        asset Type3.B == string("A");
        asset Type3.C == string("A");
    }
}