import build from "build";
import error from "error";
export func build_main(builder:*build::Builder): error::Result[build::BuildError,void] {
  var main_target = builder.new("main", build::Execute);
  main_target.addSourceDirectory(builder.workspace("./src/main.cubec"));
  main_target.addEntry("main.cubec", "main");
  main_target.setOutpuDirectory(builder.workspace("./build/"));
  _ = main_target.build().?;
}