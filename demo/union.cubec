import { printf } from 'io';
import { Error } from 'error';
func div(a: int32_t, b:int32_t): Error|int32_t {
    if (b == 0) {
        return Error.create("division with zero");
    }
    return a/b;
}

func test(): Error|void {
    match div(1,0) {
        case Error(error) {
            return error;
        }
        case int32_t(value) {
            match printf("%d\n", value){
                Error(error){
                    return error;
                }
            }
        }
    }
}